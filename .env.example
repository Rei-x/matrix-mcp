# Required: Matrix homeserver (no trailing slash)
MATRIX_BASE_URL=https://matrix.example.com

# Required: access token for the Matrix user this server acts as
MATRIX_ACCESS_TOKEN=syt_xxx

# Optional: HTTP port (default 3000)
# PORT=3000

# Optional: if set, MCP is only at https://<host>/<MCP_AUTH_TOKEN>/mcp (not /mcp or /)
# MCP_AUTH_TOKEN=
